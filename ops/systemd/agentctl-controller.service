# Template for the controller system unit. Not installed by CI.
# Do not copy this onto racknerd_us from an agent session.
# Phase 1 starts the TypeScript entry with Node's type stripper. Node >= 22.19.
# Secrets stay in /home/agentctl/secrets (mode 0700) and are never stored in this file.
# Session leaves under /home/sbx/workspaces are created by sbx-workspace.service.
# Do not add that path to ReadWritePaths. NoNewPrivileges and ProtectSystem stay as below.

[Unit]
Description=pi-personal-agents controller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=agentctl
Group=agentctl
WorkingDirectory=/home/agentctl/app
EnvironmentFile=-/home/agentctl/secrets/controller.env
ExecStart=/usr/bin/node --experimental-strip-types /home/agentctl/app/src/controller.ts
Restart=on-failure
RestartSec=2
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=no
ReadWritePaths=/home/agentctl/data /home/agentctl/secrets
ReadOnlyPaths=/home/agentctl/app
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
